<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permet de compiler l'app Windows depuis macOS (et en CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WisperKit</AssemblyName>
    <RootNamespace>WisperKit.App</RootNamespace>
    <Version>0.2.0</Version>
    <Product>WisperKit</Product>
    <Company>eldriic</Company>
    <Copyright>© 2026 eldriic — MIT</Copyright>
    <ApplicationIcon>Assets\WisperKit.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WisperKit.Core\WisperKit.Core.csproj" />
    <Resource Include="Assets\icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- Whisper.net copie les binaires natifs de toutes les plateformes : on ne garde que
       l'architecture publiée (CPU + Vulkan), soit ~115 Mo de moins. -->
  <Target Name="PruneForeignRuntimes" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_WkForeign Include="$(PublishDir)runtimes/**/*"
                  Exclude="$(PublishDir)runtimes/$(RuntimeIdentifier)/**;$(PublishDir)runtimes/vulkan/$(RuntimeIdentifier)/**" />
      <_WkForeignDirs Include="@(_WkForeign->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Delete Files="@(_WkForeign)" />
    <RemoveDir Directories="@(_WkForeignDirs->Distinct())" />
  </Target>

</Project>
